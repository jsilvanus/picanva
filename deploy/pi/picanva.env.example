# Copy to /home/pi/apps/picanva.env (chmod 600). Never commit the real file.

# Bind address and port. Keep it on the LAN or 127.0.0.1; do not put it on the WAN port.
PICANVA_HOST=127.0.0.1
PICANVA_PORT=3100

# simulation (default) or production. Production refuses to start without PICANVA_API_KEY.
PICANVA_MODE=production
PICANVA_API_KEY=change-me

# piprogram that owns slide display (required). Its key is sent as the x-api-key header.
PICANVA_PIPROGRAM_URL=http://127.0.0.1:3000
PICANVA_PIPROGRAM_API_KEY=change-me-piprogram
PICANVA_PIPROGRAM_TIMEOUT_MS=15000

# Hosts exported pages may be downloaded from (https only, suffix match).
PICANVA_ASSET_HOSTS=canva.com,canva-usercontent.com
# Max raw bytes per page. Hard limit 37 MB: piprogram accepts 50 MB JSON bodies and media goes out base64.
PICANVA_MAX_ASSET_BYTES=31457280

# Canva Connect API for autoExport. Leave empty to use exportUrls only.
CANVA_API_BASE_URL=https://api.canva.com/rest
CANVA_ACCESS_TOKEN=
PICANVA_EXPORT_POLL_MS=2000
PICANVA_EXPORT_TIMEOUT_MS=180000
