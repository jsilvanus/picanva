# Build-time environment variables for picanva
# These variables are baked into the static bundle during `npm run build`

# Display name of the plugin inside Canva
VITE_APP_NAME="Keskuskirkko Slide Bridge"

# Target Pi Gateway base URL (must be HTTPS in production Canva environment)
VITE_GATEWAY_URL="https://gateway.keskuskirkko.fi:8443"

# Scoped API Key for Pi Gateway Canva endpoints
VITE_GATEWAY_API_KEY="church-canva-secret-key"
