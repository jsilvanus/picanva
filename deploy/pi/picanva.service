[Unit]
Description=picanva (Canva bridge to piprogram)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/pi/apps/picanva
EnvironmentFile=/home/pi/apps/picanva.env
Environment=PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pi/.local/bin/node src/main.mjs
Restart=on-failure

[Install]
WantedBy=default.target
